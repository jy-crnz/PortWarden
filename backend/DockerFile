# 1. Use an official, lightweight Python image
FROM python:3.11-slim

# 2. Set environment variables to optimize Python for Docker
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 3. Set the working directory inside the container
WORKDIR /app

# 4. Install system dependencies (CRITICAL: This installs Nmap)
# We also install libpq-dev which is required for PostgreSQL adapters
RUN apt-get update && apt-get install -y \
    nmap \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 5. Copy the requirements file and install Python dependencies
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

# 6. Copy the rest of the Django project code into the container
COPY . /app/

# 7. Expose the port Django will run on
EXPOSE 8000

# 8. Start the production server (Gunicorn)
# NOTE: Replace 'core.wsgi:application' with your actual project folder name if it's different.
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "120", "portwarden_core.wsgi:application"]